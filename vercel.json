{
  "rewrites": [
    {
      "source": "/((?!api/|assets/|strains/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/((?!assets/|strains/).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/qbo/cron",
      "schedule": "7 14-23 * * 1-6"
    },
    {
      "path": "/api/qbo/cron",
      "schedule": "7 0-3 * * 0,2-6"
    },
    {
      "path": "/api/weather/refresh",
      "schedule": "13 * * * *"
    },
    {
      "path": "/api/compliance/backup",
      "schedule": "17 10 * * *"
    },
    {
      "path": "/api/metrc/worker",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/metrc/sync",
      "schedule": "47 10 * * *"
    },
    {
      "path": "/api/metrc/sync?only=plants",
      "schedule": "17 11 * * *"
    },
    {
      "path": "/api/metrc/night",
      "schedule": "23 9 * * *"
    }
  ]
}
